cd ~/GremioMantos/api

cat > .funcignore << 'EOF'
# Build artifacts
*. js. map
*.ts
. git*
. vscode
local. settings.json
test
.DS_Store
*.md

# Diretórios desnecessários
src/
node_modules/@types/
. github/
.editorconfig
tsconfig.json

# Logs e temporários
*. log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
EOF

echo "✅ .funcignore criado!"
